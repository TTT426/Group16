# 複製成 .env 後填入。請勿把 .env commit 進 repo。

DATABASE_URL=postgresql+psycopg://group16:group16@localhost:5432/group16

# LLM provider：claude_cli | anthropic_api | fake
#   claude_cli    -> 使用已登入的 Claude Code CLI（走 Pro/Max 訂閱額度）
#   anthropic_api -> 使用 ANTHROPIC_API_KEY（按量計費）
#   fake          -> 離線開發 / 測試用，不呼叫任何模型
LLM_PROVIDER=claude_cli
# 留空 = 使用各 provider 的預設模型（anthropic_api 預設 claude-opus-5-5；claude_cli 用 CLI 目前的設定）
LLM_MODEL=
# anthropic_api 的 effort（low | medium | high | xhigh | max），留空表示不送
LLM_EFFORT=medium
LLM_TIMEOUT_S=180
LLM_MAX_CONCURRENCY=2

# claude_cli 專用
CLAUDE_CLI_PATH=claude
# true = 呼叫 CLI 時移除 ANTHROPIC_API_KEY，確保走訂閱額度、不會意外改成 API 計費
CLAUDE_CLI_STRIP_API_KEY=true

# anthropic_api 專用
ANTHROPIC_API_KEY=

# Embedding：bge（本地 sentence-transformers，需 pip install -e ".[embeddings]"）| hashing（離線 / 測試，只比對字詞）
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 連接器
# GitHub：fine-grained token，對該 repo 給 Issues / Pull requests / Contents 的 read 權限
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_INCLUDE_MARKDOWN=true
# Notion：建立 internal integration，並在要匯入的頁面「Connections」加入它（只會讀到有分享給它的頁面）
NOTION_TOKEN=
# Discord：bot 要在伺服器裡、有 Read Message History，並在 Developer Portal 開啟 Message Content Intent
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
