# 複製成 .env 後依需要修改（start.bat / start.sh 第一次執行會自動複製）。請勿把 .env commit 進 repo。
# 所有設定都有預設值：什麼都不填也能啟動。

# 資料庫：SQLite 檔案（Python 內建，不需要安裝任何資料庫）。相對路徑以 repo 根目錄為準。
DATABASE_PATH=data/group16.db

# LLM：使用已登入的 Claude Code CLI（Pro/Max 訂閱額度）。先安裝 Claude Code 並執行一次 `claude` 登入。
#   claude_cli -> 正式使用
#   fake       -> 只給測試 / 離線開發用，不呼叫任何模型
LLM_PROVIDER=claude_cli
# 留空 = 使用 CLI 目前的預設模型；也可以填 opus、sonnet 或完整模型名稱
LLM_MODEL=
LLM_TIMEOUT_S=180
LLM_MAX_CONCURRENCY=2
CLAUDE_CLI_PATH=claude
# true = 呼叫 CLI 時移除 ANTHROPIC_API_KEY 環境變數，確保走訂閱額度、不會改成 API 計費
CLAUDE_CLI_STRIP_API_KEY=true

# AI 問答模式：rag | full | agent（比較結果見 docs/EVAL_MODES.md）
QA_MODE=rag

# Embedding：auto | fastembed | hashing
#   auto      -> 有裝 fastembed 就用（預設模型 BAAI/bge-small-zh-v1.5，約 90 MB），否則用 hashing
#   fastembed -> 小型 ONNX 模型，不需要 torch（pip install -e ".[embeddings]"，start.bat 會自動裝）
#                EMBEDDING_MODEL 可以換成 fastembed 支援的其他模型
#   hashing   -> 不需要任何套件，只比對字詞
# 換模型後不用手動處理：start.bat 會自動重新計算向量（或執行 python scripts/ingest.py --if-empty --scenario ...）
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=

# 連接器
# Easiest: connect the tools on the "Connect tools" page (http://127.0.0.1:8001/connect); it writes this file for you.
# GitHub sign-in on that page saves GITHUB_TOKEN; GITHUB_USE_GH_CLI=true means "use the GitHub CLI login (gh auth login)".
# GITHUB_CLIENT_ID: client id of the team's GitHub OAuth App for "Sign in with GitHub" (public, not a secret).
GITHUB_CLIENT_ID=
GITHUB_USE_GH_CLI=false
# GitHub：fine-grained token，對該 repo 給 Issues / Pull requests / Contents 的 read 權限
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_INCLUDE_MARKDOWN=true
# Notion：建立 internal integration，並在要匯入的頁面「Connections」加入它（只會讀到有分享給它的頁面）
NOTION_TOKEN=
# Seeding only (the evaluation test workspace): SEED_GITHUB_REPO is an EMPTY test repo (owner/repo) the seed script
# writes into (creates issues, merges pull requests, commits files). Never the team's real repo: GITHUB_REPO is the
# repo the app reads, and seeding refuses to run when the two are the same.
SEED_GITHUB_REPO=
# Seeding only: SEED_NOTION_TOKEN is the API token of a SEPARATE Notion connection for the test workspace (it must be
# able to see NOTION_PARENT_PAGE_ID). Never NOTION_TOKEN: every page the app's connection can see is imported.
SEED_NOTION_TOKEN=
# 只有 seed 腳本需要：情境頁面要建立在哪個頁面底下（該頁面也要分享給 integration）
NOTION_PARENT_PAGE_ID=
# Discord：bot 要在伺服器裡、有 Read Message History，並在 Developer Portal 開啟 Message Content Intent
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Seeding only: SEED_DISCORD_GUILD_ID is a SEPARATE test server the scenarios are posted into (the same bot can be in
# both; it needs Manage Channels, Create Public Threads and Manage Webhooks there). Never DISCORD_GUILD_ID.
SEED_DISCORD_GUILD_ID=
